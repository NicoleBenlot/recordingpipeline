# ---------------------------------------------------------------------------
# CLI Audio Capture & Asset Pipeline — environment configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your values.
# All values are read via python-dotenv in the `config` module.

# --- Storage ---------------------------------------------------------------
# Base directory that holds all captured/archived assets.
OUTPUT_DIR=./recordings

# Name of the structured index text file (kept inside OUTPUT_DIR).
INDEX_FILENAME=audio_index.txt

# Optional absolute path override. If set, it takes precedence over OUTPUT_DIR.
# ARTIFACT_ROOT=

# Optional subdirectory (relative to the destination) where the .mp3 files
# are written. The index file stays at the destination root.
# Example: AUDIO_SUBDIR=audio  ->  <destination>/audio/<name>.mp3
AUDIO_SUBDIR=audio

# --- Capture ---------------------------------------------------------------
# Default recording duration in seconds.
DURATION_SECONDS=5.0

# Audio device to use. Leave empty to use the system default.
# Use `python -m audio_pipeline --list-devices` to enumerate options.
INPUT_DEVICE=

# Sample rate in Hz.
SAMPLE_RATE=44100

# Number of input channels (1 = mono, 2 = stereo).
CHANNELS=1

# --- Processing ------------------------------------------------------------
# Background noise reduction. Set to 0/false to archive the raw signal and
# skip the automatic denoise pass (the GUI's Denoise button and the CLI's
# [f] option stay available either way).
# NOTE: the GUI's "Background noise reduction" checkbox rewrites this key
# in this file, so the choice survives a restart.
REDUCE_NOISE=1

# Default noise-reduction strength in [0.0, 1.0] (first pass).
FILTER_PROP_DECREASE=0.75

# Aggressive strength used on re-filter passes.
FILTER_AGGRESSIVE_PROP=0.95

# Maximum number of noise-reduction passes before auto-commit.
MAX_FILTER_PASSES=2

# --- Archival --------------------------------------------------------------
# Output audio format / codec: mp3 (default), opus, ogg, wav.
# NOTE: 'opus' and 'ogg' need the matching encoders available to pydub
# (e.g. opusenc/oggenc from ffmpeg on PATH).
AUDIO_FORMAT=opus

# Target bitrate for compressed formats (mp3/opus/ogg).
MP3_BITRATE=192k

# Number where auto-increment begins for new words (extends an existing
# library across sessions).
INDEX_START_NUMBER=1

# How many leading letters group words into index sections (e.g. 2 -> [si]).
INDEX_PREFIX_LENGTH=2

# What to do when a word is recorded again.
#   0/false - overwrite: reuse an existing take's number (latest by default,
#             or the one picked in the GUI's "Overwrite take" dropdown).
#   1/true  - keep every take: each recording gets a new number, so the
#             index entry becomes a list (amo = 1, 2 -> 1.opus + 2.opus).
# Session-only: the GUI checkbox always starts from this value (default off).
MULTI_SPEAKER=0

# --- Logging ---------------------------------------------------------------
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO
